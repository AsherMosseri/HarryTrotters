rules_version = '2';
// Cloud Storage rules for task photos. Paste into Firebase console →
// Storage → Rules. Only devices signed in with a password (they have a
// members/{uid} doc in Firestore with via: 'password') can see, add, or
// delete photos.
service firebase.storage {
  match /b/{bucket}/o {
    function isMember() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/members/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/members/$(request.auth.uid)).data.get('via', '') == 'password';
    }

    // Robot CAD exports (.glb / .gltf). Only managers delete them.
    match /robot/{file} {
      allow read: if isMember();
      allow create: if isMember() && request.resource.size < 100 * 1024 * 1024;
      allow delete: if isMember()
        && firestore.get(/databases/(default)/documents/members/$(request.auth.uid)).data.get('admin', false) == true;
    }

    function isManager() {
      return isMember()
        && firestore.get(/databases/(default)/documents/members/$(request.auth.uid)).data.get('admin', false) == true;
    }

    // Chat photos (shrunk JPEGs) and animated GIFs (uploaded as-is). Files can
    // be opened by their link but folders can't be listed.
    match /chat/{channelId}/{file} {
      allow get, delete: if isMember();
      allow create: if isMember() && (
        (request.resource.contentType == 'image/jpeg' && request.resource.size < 5 * 1024 * 1024)
        || (request.resource.contentType == 'image/gif' && request.resource.size < 8 * 1024 * 1024)
      );
    }

    // Profile pictures (cropped, shrunk JPEGs), named <person-id>-<random>.jpg.
    // Only that person (by the name they joined with) or team management
    // removes one.
    function myPersonId() {
      return firestore.get(/databases/(default)/documents/members/$(request.auth.uid)).data.name.lower().replace('[^a-z0-9]+', '-');
    }
    match /avatars/{file} {
      allow get: if isMember();
      allow delete: if isManager() || (isMember() && file.matches(myPersonId() + '-.*'));
      allow create: if isMember() && (
        (request.resource.contentType == 'image/jpeg' && request.resource.size < 1024 * 1024)
        || (request.resource.contentType == 'image/gif' && request.resource.size < 4 * 1024 * 1024)
      );
    }

    // Profile banners, same idea as pictures.
    match /banners/{file} {
      allow get: if isMember();
      allow delete: if isManager() || (isMember() && file.matches(myPersonId() + '-.*'));
      allow create: if isMember() && (
        (request.resource.contentType == 'image/jpeg' && request.resource.size < 2 * 1024 * 1024)
        || (request.resource.contentType == 'image/gif' && request.resource.size < 6 * 1024 * 1024)
      );
    }

    // Pictures for custom profile effects (small; GIFs stay animated).
    match /effects/{file} {
      allow get: if isMember();
      allow delete: if isManager() || (isMember() && file.matches(myPersonId() + '-.*'));
      allow create: if isMember()
        && request.resource.contentType.matches('image/(png|gif|jpeg|webp)') && request.resource.size < 2 * 1024 * 1024;
    }

    // Pictures and GIFs for ads (Asher's own and teammates' booked spots).
    match /adpics/{file} {
      allow get: if isMember();
      allow delete: if isManager() || (isMember() && file.matches(myPersonId() + '-.*'));
      allow create: if isMember() && file.matches(myPersonId() + '-.*') && (
        (request.resource.contentType == 'image/jpeg' && request.resource.size < 1024 * 1024)
        || (request.resource.contentType == 'image/gif' && request.resource.size < 4 * 1024 * 1024)
      );
    }

    // Files sent in chat (any kind, up to 25 MB): videos, PDFs, CAD files…
    match /files/{conv}/{file} {
      allow get, delete: if isMember();
      allow create: if isMember() && request.resource.size < 25 * 1024 * 1024;
    }

    // Team stickers, added by team management.
    match /stickers/{file} {
      allow get: if isMember();
      allow create: if isManager()
        && request.resource.contentType.matches('image/(png|gif|jpeg|webp)') && request.resource.size < 2 * 1024 * 1024;
      allow delete: if isManager();
    }

    // Team emoji, added by team management.
    match /emoji/{file} {
      allow get: if isMember();
      allow create: if isManager()
        && request.resource.contentType.matches('image/(png|gif|jpeg|webp)') && request.resource.size < 1024 * 1024;
      allow delete: if isManager();
    }

    // Lab log voice notes (up to 30 seconds), named <person-id>-<random>.
    // iPad and iPhone record audio/mp4; other browsers WebM or Ogg.
    match /voice/{file} {
      allow get: if isMember();
      allow delete: if isManager() || (isMember() && file.matches(myPersonId() + '-.*'));
      allow create: if isMember()
        && request.resource.contentType.matches('audio/(mp4|x-m4a|aac|mpeg|webm|ogg)') && request.resource.size < 3 * 1024 * 1024;
    }

    match /tasks/{taskId}/{file} {
      allow read, delete: if isMember();
      allow create: if isMember()
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size < 5 * 1024 * 1024;
    }
  }
}
