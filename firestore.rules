rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The team code: replace the placeholder (lowercase) when you paste these
    // rules into the Firebase console. Keep the real code out of this file so
    // it never ends up on GitHub. It's only needed to set up a name on a new
    // device the first time; after that everyone signs in with their password.
    function teamCode() { return 'CHANGE-ME'; }

    function signedIn() { return request.auth != null; }
    function memberPath() { return /databases/$(database)/documents/members/$(request.auth.uid); }
    // A device signed in with a password (the account function writes these;
    // older code-only sign-ins don't count until they set or enter a password).
    function isMember() { return signedIn() && exists(memberPath()) && get(memberPath()).data.get('via', '') == 'password'; }
    function isManager() { return isMember() && get(memberPath()).data.get('admin', false) == true; }
    function validName(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 60;
    }

    // One doc per signed-in device, written only by the account function
    // (which also decides who's team management). Only that device reads it.
    match /members/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if false;
    }
    // Setting up a name with no password yet on a new device: the device leaves
    // a ticket with the team code (checked here), and the account function
    // accepts it. Nobody reads them.
    match /setupTickets/{uid} {
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.code == teamCode() && validName(request.resource.data)
        && request.resource.data.keys().hasOnly(['code', 'name', 'at']) && request.resource.data.at is int;
      allow read: if false;
      allow delete: if signedIn() && request.auth.uid == uid;
    }
    // Asher's request to reset your password: your devices show it (you answer
    // through the account function).
    match /resetRequests/{id} {
      allow read: if isMember() && isMe(resource.data.name);
      allow write: if false;
    }
    // Passwords (hashed): the account function only.
    match /accounts/{id} {
      allow read, write: if false;
    }

    // Public name list for the assignee picker; must match the member's name.
    match /people/{uid} {
      allow read: if isMember();
      allow create, update: if signedIn() && request.auth.uid == uid
        && existsAfter(/databases/$(database)/documents/members/$(uid))
        && request.resource.data.name == getAfter(/databases/$(database)/documents/members/$(uid)).data.name;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Milestones: anyone on the team can add and edit; only the manager deletes.
    match /milestones/{id} {
      allow read, create, update: if isMember();
      allow delete: if isManager();
    }

    // Org chart and team settings (competition date): manager only.
    match /roles/{id} {
      allow read: if isMember();
      allow write: if isManager();
    }
    // settings/names (renames) is readable before joining so the join screen shows current names.
    match /settings/{id} {
      allow read: if isMember() || (id == 'names' && signedIn());
      allow write: if isManager() && id != 'shutdown' && id != 'controls';
      // settings/controls: Asher's switches (src/controls.js). Asher only.
      allow write: if id == 'controls' && isOwner()
        && request.resource.data.keys().hasOnly(['off', 'tabsOff', 'channelsOff', 'labLog', 'by', 'updatedAt'])
        && request.resource.data.get('off', []) is list && request.resource.data.get('tabsOff', []) is list
        && request.resource.data.get('channelsOff', []) is list
        && request.resource.data.get('labLog', 'required') in ['required', 'optional', 'off'];
      // settings/shutdown shuts the app down for everyone else: Asher only.
      allow write: if id == 'shutdown' && isOwner() && validShutdown(request.resource.data);
    }
    // Asher's Controls (settings/controls): what's switched off for everyone
    // but him. The app hides it; these refuse it. Ids match src/controls.js.
    function controlsPath() { return /databases/$(database)/documents/settings/controls; }
    function controlsList(key) { return exists(controlsPath()) ? get(controlsPath()).data.get(key, []) : []; }
    function featureOff(id) { return !isOwner() && id in controlsList('off'); }
    function channelOff(id) { return !isOwner() && id in controlsList('channelsOff'); }
    function labLogOff() { return !isOwner() && exists(controlsPath()) && get(controlsPath()).data.get('labLog', 'required') == 'off'; }
    // Asher: the manager who joined as Asher Mosseri (that needs his manager code).
    function isOwner() { return isManager() && myName().lower() == 'asher mosseri'; }
    // people: who it's shut down for (names); empty means everyone but Asher.
    function validShutdown(d) {
      return d.keys().hasOnly(['on', 'message', 'question', 'people', 'at', 'endedAt', 'by', 'updatedAt'])
        && d.on is bool && d.message is string && d.message.size() <= 2000
        && d.get('question', '') is string && d.get('question', '').size() <= 300
        && d.get('people', []) is list && d.get('people', []).size() <= 100;
    }
    function shutdownFor(sd) { return sd.get('on', false) == true && (sd.get('people', []).size() == 0 || inPeople(sd.get('people', []))); }
    // The shutdown chats: each teammate's back-and-forth with Asher
    // (person = whose chat, name = who wrote it). Teammates read and write
    // only their own, and only while the app is shut down; Asher reads all
    // of them and can write in any.
    match /shutdownReplies/{id} {
      function validReply(d) {
        return d.keys().hasOnly(['text', 'round', 'person', 'name', 'byUid', 'at'])
          && d.byUid == request.auth.uid && isMe(d.name)
          && d.text is string && d.text.size() > 0 && d.text.size() <= 1000
          && d.person is string && d.person.size() > 0 && d.person.size() <= 60
          && d.round is int && d.at is int;
      }
      allow read: if isOwner() || (isMember() && isMe(resource.data.person));
      allow delete: if isOwner();
      allow create: if isMember() && validReply(request.resource.data)
        && (isOwner() || (isMe(request.resource.data.person)
          && shutdownFor(get(/databases/$(database)/documents/settings/shutdown).data)));
    }

    // Pretend-ad view and tap counts (the fake earnings on the Ads page).
    // Anyone can add a little at a time; only managers can reset them.
    match /adStats/{id} {
      function counts(d) { return d.keys().hasOnly(['views', 'taps']) && d.get('views', 0) is int && d.get('taps', 0) is int; }
      allow read: if isMember();
      allow create: if isMember() && id.matches('^[a-z0-9-]{1,40}$') && counts(request.resource.data)
        && request.resource.data.get('views', 0) <= 500 && request.resource.data.get('taps', 0) <= 50;
      allow update: if isMember() && counts(request.resource.data)
        && request.resource.data.get('views', 0) >= resource.data.get('views', 0)
        && request.resource.data.get('views', 0) <= resource.data.get('views', 0) + 500
        && request.resource.data.get('taps', 0) >= resource.data.get('taps', 0)
        && request.resource.data.get('taps', 0) <= resource.data.get('taps', 0) + 50;
      allow delete: if isManager();
    }

    // Jackson coins ledger: spending, gifts, prizes, and Asher's bonuses. What
    // people earn is worked out from tasks and shifts, so it isn't stored here.
    // Gifts and prizes come from the play function, which checks the balance
    // and today's limits; phones only add their own spending and Asher's bonuses.
    match /coins/{id} {
      function amount(d) { return d.amount is int && d.amount > 0 && d.amount <= 5000; }
      function shortStr(v, n) { return v is string && v.size() <= n; }
      function validSpend(d) {
        return d.keys().hasOnly(['type', 'person', 'amount', 'what', 'label', 'until', 'at']) && isMe(d.person) && amount(d)
          && shortStr(d.get('what', ''), 20) && shortStr(d.get('label', ''), 80)
          && (!('until' in d) || (d.until is int && d.until <= request.time.toMillis() + 8 * 86400000 && d.amount * 2 >= adFreePrice(d)))
          // Market buys and tournament entries are written by the server only
          // (functions/market.js), which also hands over what was bought.
          && !(d.get('what', '') in ['market', 'tournament']);
      }
      // Time without ads (`until`) costs its price in settings/team.coins.prices
      // (Ads.jsx buyRemoval: an hour, the rest of today or a week), less at
      // most the best ad coupon (50% off), so it can't be bought for 1 coin.
      function adFreePrice(d) {
        let team = /databases/$(database)/documents/settings/team;
        let p = exists(team) ? get(team).data.get('coins', {}).get('prices', {}) : {};
        let span = d.until - d.at;
        return span <= 3720000 ? p.get('hour', 10) : span <= 25 * 3600000 + 120000 ? p.get('today', 25) : p.get('week', 120);
      }
      function validGrant(d) {
        return d.keys().hasOnly(['type', 'to', 'amount', 'note', 'by', 'at']) && requestsOwner() && d.to is string
          && d.amount is int && d.amount != 0 && d.amount >= -100000 && d.amount <= 100000 && shortStr(d.get('note', ''), 140);
      }
      allow read: if isMember();
      allow create: if isMember() && !featureOff('coins') && request.resource.data.at is int
        && request.resource.data.at > nowMs() - 120000 && request.resource.data.at < nowMs() + 120000 && (
        (request.resource.data.type == 'spend' && validSpend(request.resource.data))
        || (request.resource.data.type == 'grant' && validGrant(request.resource.data)));
      allow update: if false;
      allow delete: if requestsOwner();
    }

    // The market (functions/market.js). Perks are added, changed and removed
    // by team management; buying anything, refunds, chat extras, pets and
    // tournaments happen only on the server, so the app just reads them.
    match /perks/{id} {
      function validPerk(d) {
        return d.keys().hasOnly(['name', 'desc', 'price', 'stock', 'limit', 'per', 'approval', 'active', 'idea', 'by', 'at', 'updatedAt'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 60
          && d.get('desc', '') is string && d.get('desc', '').size() <= 200
          && d.price is int && d.price >= 1 && d.price <= 5000
          && (d.get('stock', null) == null || (d.stock is int && d.stock >= 0 && d.stock <= 1000))
          && (d.get('limit', null) == null || (d.limit is int && d.limit >= 1 && d.limit <= 100))
          && d.get('per', 'season') in ['season', 'week']
          && d.get('approval', true) is bool && d.get('active', true) is bool;
      }
      allow read: if isMember();
      allow create, update: if isManager() && validPerk(request.resource.data);
      allow delete: if isManager();
    }
    match /purchases/{id} {
      allow read: if isMember();
      allow write: if false;
    }
    match /pets/{id} {
      allow read: if isMember();
      allow write: if false;
    }
    match /tournaments/{id} {
      allow read: if isMember();
      allow write: if false;
    }
    // A tournament's seed (the pieces and boards come from it): the server only.
    match /tournamentSecrets/{id} {
      allow read, write: if false;
    }

    // How many ads each person has seen and tapped (Asher's per-person stats).
    match /adPeople/{id} {
      function grows(d, k, max) {
        return d.get(k, 0) is int && d.get(k, 0) >= resource.data.get(k, 0) && d.get(k, 0) <= resource.data.get(k, 0) + max;
      }
      allow read: if isMember();
      allow create: if isMember() && id == myId() && request.resource.data.keys().hasOnly(['name', 'views', 'taps'])
        && request.resource.data.name == myName() && request.resource.data.get('views', 0) is int && request.resource.data.get('taps', 0) is int
        && request.resource.data.get('views', 0) <= 2000 && request.resource.data.get('taps', 0) <= 100;
      allow update: if isMember() && id == myId() && request.resource.data.keys().hasOnly(['name', 'views', 'taps'])
        && request.resource.data.name == resource.data.name && grows(request.resource.data, 'views', 2000) && grows(request.resource.data, 'taps', 100);
      allow delete: if isManager();
    }

    // Ads teammates submit and book for certain dates. Asher reviews them on
    // the Ads page; approved ones run for everyone during their dates.
    match /adSubmissions/{id} {
      function str(v, n) { return v is string && v.size() <= n; }
      function validAction(a) {
        return a is map && a.keys().hasOnly(['kind', 'ask', 'done', 'item'])
          && str(a.get('kind', ''), 12) && str(a.get('ask', ''), 80) && str(a.get('done', ''), 140) && str(a.get('item', ''), 40);
      }
      function validSubmission(d) {
        return d.keys().hasOnly(['by', 'brand', 'emoji', 'headline', 'body', 'cta', 'sticker', 'fine', 'colors', 'anim', 'action', 'from', 'to', 'status', 'note', 'at', 'image'])
          && str(d.get('image', ''), 600) && (d.get('image', '') == '' || d.get('image', '').matches('https://firebasestorage[.]googleapis[.]com/.*'))
          && str(d.brand, 40) && d.brand.size() > 0 && str(d.headline, 70) && d.headline.size() > 0
          && str(d.get('emoji', ''), 16) && str(d.get('body', ''), 160) && str(d.get('cta', ''), 28) && str(d.get('sticker', ''), 14)
          && str(d.get('fine', ''), 140) && str(d.get('anim', ''), 12) && str(d.get('note', ''), 140)
          && d.get('colors', []) is list && d.get('colors', []).size() <= 2 && validAction(d.get('action', {}))
          && str(d.from, 10) && str(d.to, 10) && d.from <= d.to;
      }
      allow read: if isMember();
      allow create: if isMember() && validSubmission(request.resource.data) && isMe(request.resource.data.by)
        && request.resource.data.status == 'pending';
      allow update: if (requestsOwner() && validSubmission(request.resource.data)
          && request.resource.data.status in ['pending', 'approved', 'rejected', 'ended'])
        || (isMember() && isMe(resource.data.by) && resource.data.status == 'pending' && validSubmission(request.resource.data)
          && request.resource.data.by == resource.data.by && request.resource.data.status in ['pending', 'withdrawn']);
      allow delete: if requestsOwner() || (isMember() && isMe(resource.data.by) && resource.data.status != 'approved');
    }

    // The casino and economy: everyone's winnings and losses, and the Friday
    // lottery, readable by the team; only the play function writes them.
    match /bank/{id} {
      allow read: if isMember();
    }
    match /lottery/{id} {
      allow read: if isMember();
    }
    // Decks, mine spots, and crash points: the server only.
    match /gameSecrets/{id} {
      allow read, write: if false;
    }
    // Tetris and Minesweeper games (seeds, results, what they paid) and the
    // tournament board key: the funGame function only.
    match /funGames/{id} {
      allow read, write: if false;
    }
    match /funSecrets/{id} {
      allow read, write: if false;
    }
    // A live race's picture of each player's board (shown small to the other
    // player). Only for showing: the result comes from the replayed moves.
    // One doc per player's device, id <race>_<uid>.
    match /raceLive/{id} {
      allow read: if isMember();
      allow create, update: if isMember() && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.race + '_' + request.auth.uid
        && isMe(request.resource.data.name)
        && request.resource.data.keys().hasOnly(['race', 'uid', 'name', 'at', 'game', 'board', 'score', 'lines', 'cells', 'over', 'done'])
        && request.resource.data.race is string && request.resource.data.race.size() <= 40
        && request.resource.data.board is string && request.resource.data.board.size() <= 600
        && request.resource.data.at is int;
      allow delete: if isMember() && resource.data.uid == request.auth.uid;
    }

    // Learn (functions/learn.js): only the server writes these. You read your
    // own progress and daily answers (a missing doc reads as empty). Open
    // team-data answers and the daily question list stay on the server.
    match /quizState/{id} {
      allow read: if isMember() && (resource == null || isMe(resource.data.name));
      allow write: if false;
    }
    match /dailyAnswers/{id} {
      allow read: if isMember() && (resource == null || isMe(resource.data.name));
      allow write: if false;
    }
    match /quizSecrets/{id} {
      allow read, write: if false;
    }
    match /quizMeta/{id} {
      allow read, write: if false;
    }
    // "Something's wrong with this question": team management reads them
    // (with the answer) and marks them handled.
    match /quizReports/{id} {
      allow read, delete: if isManager();
      allow update: if isManager()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'handledBy', 'handledAt'])
        && request.resource.data.status in ['open', 'fixed', 'fine'];
      allow create: if false;
    }

    // The lab log (labLog.js): one log per person per day, id <day>_<person>.
    // Everyone on the team reads them; you write your own (it's required
    // when you end a shift); team management can fix anyone's. The onLabLog
    // function keeps #lab-log's daily card in sync. Since 3.0 a log is
    // mostly taps (areas, tasks and how they went); logs from before need a
    // note, newer ones need at least one area.
    match /labLogs/{id} {
      function validLog(d) {
        return d.keys().hasOnly(['day', 'person', 'uid', 'note', 'taskIds', 'doneTaskIds', 'photos', 'blockers', 'next', 'at', 'updatedAt', 'updatedBy',
            'v', 'areas', 'tasks', 'chips', 'voice', 'workedWith', 'shiftIds'])
          && d.day is string && d.day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && d.person is string && d.note is string && d.note.size() <= 4000
          && (d.note.size() > 0 || (d.get('areas', []) is list && d.get('areas', []).size() > 0))
          && d.get('blockers', '') is string && d.get('blockers', '').size() <= 2000
          && d.get('next', '') is string && d.get('next', '').size() <= 2000
          && d.get('photos', []) is list && d.get('photos', []).size() <= 4
          && d.get('taskIds', []) is list && d.get('taskIds', []).size() <= 30
          && d.get('doneTaskIds', []) is list && d.get('doneTaskIds', []).size() <= 30
          && d.get('areas', []) is list && d.get('areas', []).size() <= 7
          && d.get('tasks', []) is list && d.get('tasks', []).size() <= 30
          && d.get('chips', []) is list && d.get('chips', []).size() <= 30
          && d.get('workedWith', []) is list && d.get('workedWith', []).size() <= 20
          && d.get('shiftIds', []) is list && d.get('shiftIds', []).size() <= 10
          && (d.get('voice', null) == null || (d.voice is map && d.voice.url is string && d.voice.url.size() <= 2000));
      }
      allow read: if isMember();
      allow create: if isMember() && !labLogOff() && validLog(request.resource.data) && (isMe(request.resource.data.person) || isManager());
      allow update: if isMember() && !labLogOff() && validLog(request.resource.data) && request.resource.data.person == resource.data.person
        && (isMe(resource.data.person) || isManager());
      allow delete: if isManager();
    }
    // How often the team taps each lab log suggestion chip, so the common
    // ones come first: one small doc of counts anyone on the team bumps.
    match /labChips/{id} {
      allow read: if isMember();
      allow create, update: if isMember() && id == 'counts'
        && request.resource.data.keys().hasOnly(['counts', 'updatedAt'])
        && request.resource.data.counts is map && request.resource.data.counts.size() <= 200;
    }
    // Tasks you opened, moved or commented on today (the lab log picks them
    // for you), id <day>_<person>. Yours only; team management can read them
    // when fixing your log.
    match /labTouches/{id} {
      allow read: if isMember() && (isMe(resource.data.person) || isManager());
      allow create, update: if isMember() && isMe(request.resource.data.person)
        && (resource == null || resource.data.person == request.resource.data.person)
        && request.resource.data.keys().hasOnly(['day', 'person', 'taskIds', 'at'])
        && request.resource.data.day is string && id.matches(request.resource.data.day + '_.+')
        && request.resource.data.taskIds is list && request.resource.data.taskIds.size() <= 200;
      allow delete: if isManager();
    }

    // /remind: your own reminders. The reminders function sends each one to
    // your inbox (and phone) when it's due, then deletes it.
    match /reminders/{id} {
      allow read, delete: if isMember() && isMe(resource.data.by);
      allow create: if isMember() && isMe(request.resource.data.by)
        && request.resource.data.keys().hasOnly(['by', 'at', 'text', 'conv', 'created'])
        && request.resource.data.at is number && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 200
        && request.resource.data.conv is string && request.resource.data.conv.size() <= 120;
    }

    // What happens after you book / order / submit / subscribe from an ad
    // (adOrders.js). Only yours: you see and cancel your own. The notifications
    // go only to the name it was made by, and only the server (adDeliveries)
    // updates them.
    match /adOrders/{id} {
      function validOrder(d) {
        return d.keys().hasOnly(['by', 'kind', 'adId', 'brand', 'emoji', 'item', 'qty', 'when', 'text', 'ref', 'at', 'sent', 'due', 'events', 'extra', 'vars', 'summary'])
          && d.get('vars', {}) is map && d.get('vars', {}).size() <= 12
          && d.get('summary', []) is list && d.get('summary', []).size() <= 6
          && d.kind in ['order', 'book', 'submit', 'subscribe']
          && d.brand is string && d.brand.size() <= 60 && d.item is string && d.item.size() <= 60
          && d.emoji is string && d.emoji.size() <= 16 && d.text is string && d.text.size() <= 200
          && d.adId is string && d.adId.size() <= 60 && d.ref is string && d.ref.size() <= 20
          && d.qty is int && d.qty >= 1 && d.qty <= 99 && d.when is number && d.at is number
          && d.sent == 0 && (d.due == null || d.due is number)
          && d.events is list && d.events.size() >= 1 && d.events.size() <= 8 && d.extra is map;
      }
      allow read: if isMember() && isMe(resource.data.by);
      allow create: if isMember() && isMe(request.resource.data.by) && validOrder(request.resource.data);
      allow delete: if isMember() && isMe(resource.data.by);
    }

    // Parts tracker: anyone on the team. Checklists: anyone edits, managers delete.
    match /parts/{id} {
      allow read, write: if isMember();
    }
    match /checklists/{id} {
      allow read, create, update: if isMember();
      allow delete: if isManager();
    }

    // Resources tab. Team links: anyone adds; the person who added one, or
    // team management, changes or removes it.
    match /resources/{id} {
      allow read: if isMember();
      allow create: if isMember() && request.resource.data.byUid == request.auth.uid
        && request.resource.data.title is string && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.url is string && request.resource.data.url.matches('https?://.+')
        && request.resource.data.url.size() <= 2000;
      allow update: if (isManager() || (isMember() && resource.data.byUid == request.auth.uid))
        && request.resource.data.byUid == resource.data.byUid
        && request.resource.data.url is string && request.resource.data.url.matches('https?://.+');
      allow delete: if isManager() || (isMember() && resource.data.byUid == request.auth.uid);
    }
    // Private notes about teammates: only the person who wrote them can read
    // or change them (notes/{their id}).
    function myId() { return myName().lower().replace('[^a-z0-9]+', '-').replace('^-|-$', ''); }
    // How far you've read each conversation (so every device agrees). Only yours.
    match /chatReads/{id} {
      allow read: if isMember() && id == myId();
      allow create, update: if isMember() && id == myId() && request.resource.data.owner == myName()
        && request.resource.data.reads is map && request.resource.data.reads.size() <= 400;
    }
    match /notes/{id} {
      allow read: if isMember() && id == myId();
      allow create, update: if isMember() && id == myId() && request.resource.data.owner == myName()
        && request.resource.data.notes is map;
      allow delete: if isMember() && id == myId();
    }
    // Diagrams (diagrams/electrical). The app lets Electrical and team
    // management edit; earlier versions are kept in the doc's history.
    match /diagrams/{id} {
      allow read, write: if isMember();
    }

    // The name this device joined with, and whether a name is that person
    // (also after one rename in settings/names).
    function myName() { return get(memberPath()).data.name; }
    function namesPath() { return /databases/$(database)/documents/settings/names; }
    function renamedMe() {
      return exists(namesPath()) ? get(namesPath()).data.get('renames', {}).get(myName(), '') : '';
    }
    // renamedMe() is '' for someone never renamed, and '' is nobody.
    function isMe(name) { return name == myName() || (name == renamedMe() && name != ''); }
    function inPeople(people) { return myName() in people || (renamedMe() != '' && renamedMe() in people); }

    // A new message: posted as yourself, sane size, and only team management
    // can @everyone.
    function validMessage() {
      let m = request.resource.data;
      return m.byUid == request.auth.uid
        && m.text is string && m.text.size() <= 4000
        && (m.get('everyone', false) == false || isManager())
        && !serverCommand(m)
        && contentAllowed(m);
    }
    // Nothing that's switched off (Controls) in a new message.
    function contentAllowed(m) {
      return (m.get('gif', null) == null || !featureOff('gifs'))
        && (m.get('photo', null) == null || !featureOff('photos'))
        && (m.get('files', []).size() == 0 || !featureOff('files'))
        && (m.get('poll', null) == null || !featureOff('polls'))
        && (m.get('sticker', null) == null || !featureOff('stickers'))
        && (m.get('replyTo', null) == null || !featureOff('replies'))
        && (m.get('mentions', []).size() == 0 || !featureOff('mentions'))
        && (m.get('everyone', false) == false || !featureOff('everyone'));
    }
    // Changes to a message that are switched off (Controls): reactions, pins,
    // poll votes, and editing (deleting your own still works).
    function changeAllowed() {
      let k = request.resource.data.diff(resource.data).affectedKeys();
      return (!k.hasAny(['reactions', 'supers']) || !featureOff('reactions'))
        && (!k.hasAny(['pinned', 'pinnedBy', 'pinnedAt']) || !featureOff('pins'))
        && (!k.hasAny(['votes']) || !featureOff('polls'))
        && (!k.hasAny(['text']) || request.resource.data.get('deleted', false) == true || !featureOff('editing'));
    }
    // Casino, economy, and arcade game cards only come from the server (the
    // play function), so nobody can post a fake jackpot or a fake win.
    function serverCommand(m) {
      return 'cmd' in m && m.cmd is map && m.cmd.get('name', '') in
        ['slots', 'dice', 'coinflip', 'roulette', 'blackjack', 'crash', 'mines', 'highlow', 'lottery', 'daily', 'work', 'beg', 'rob',
         'rps', 'tictactoe', 'connect4', 'duel', 'trivia', 'hangman', 'typerace', 'heist', 'labday', 'recap',
         'battleship', 'tetris', 'minesweep'];
    }
    // ...or change one afterwards (team management can still edit/delete).
    function keepsCmd() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['cmd', 'bot']);
    }
    // The message's author: sent from this device, or by this person from
    // another one (each device signs in with its own id).
    // A message sent before a rename keeps the old name, so that name renamed
    // to yours counts too.
    function isAuthor() {
      let by = resource.data.get('by', '');
      return resource.data.byUid == request.auth.uid
        || (resource.data.get('bot', false) != true && (isMe(by)
          || (exists(namesPath()) && get(namesPath()).data.get('renames', {}).get(by, '') == myName())));
    }
    // Changes anyone in the conversation may make to someone else's message:
    // reactions, poll votes, and pins.
    function sharedChange() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['reactions', 'supers', 'votes', 'pinned', 'pinnedBy', 'pinnedAt']);
    }

    // Chat channels. Defaults live in the app; team management adds, renames,
    // and removes channels here.
    match /channels/{channelId} {
      allow read: if isMember();
      allow write: if isManager();
    }
    // Post only as yourself. Authors edit/delete their own messages (delete
    // leaves a placeholder); managers can change or remove any message.
    match /channels/{channelId}/messages/{msgId} {
      allow read: if isMember();
      allow create: if isMember() && validMessage() && (channelId != 'announcements' || isManager()) && !channelOff(channelId);
      allow update: if isMember() && !channelOff(channelId) && changeAllowed()
        && (isManager() || ((isAuthor() || sharedChange()) && keepsCmd()));
      allow delete: if isManager();
    }

    // Direct messages: the people in them can read and post. Team management can
    // read every DM but can't post in other people's DMs.
    match /dms/{dmId} {
      allow read: if isMember() && (isManager() || inPeople(resource.data.people));
      allow create: if isMember() && !featureOff('dms') && request.resource.data.people is list
        && request.resource.data.people.size() >= 2 && request.resource.data.people.size() <= 12
        && inPeople(request.resource.data.people);
      allow update: if isMember() && (isManager() || (inPeople(resource.data.people)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastAt', 'lastBy', 'lastText', 'name'])));
      allow delete: if isManager();

      function dmPeople() { return get(/databases/$(database)/documents/dms/$(dmId)).data.people; }
      match /messages/{msgId} {
        allow read: if isMember() && (isManager() || inPeople(dmPeople()));
        allow create: if isMember() && !featureOff('dms') && validMessage() && inPeople(dmPeople());
        allow update: if isMember() && !featureOff('dms') && changeAllowed() && (isManager() || (inPeople(dmPeople())
          && (isAuthor() || sharedChange()) && keepsCmd()));
        allow delete: if isManager();
      }
    }

    // Profiles: picture, status, and notification settings. Your own (by the
    // name you joined with), or anyone's for team management.
    match /profiles/{id} {
      allow read: if isMember();
      allow create: if isMember() && (isManager() || isMe(request.resource.data.name));
      allow update: if isMember() && (isManager()
        || (isMe(request.resource.data.name) && request.resource.data.name == resource.data.name));
      allow delete: if isManager();
    }

    // Who's online and typing: one doc per device, written only by that device.
    match /presence/{uid} {
      allow read: if isMember();
      allow write: if isMember() && request.auth.uid == uid;
    }

    // Team stickers, added and removed by team management.
    match /stickers/{id} {
      allow read: if isMember();
      allow write: if isManager();
    }

    // Team emoji (:name:), added and removed by team management.
    match /emoji/{name} {
      allow read: if isMember();
      allow write: if isManager();
    }

    // Robot tab: anyone uploads versions and adds pins/layouts; authors or
    // managers remove pins and layouts; only managers delete versions.
    match /robotVersions/{id} {
      allow read, create, update: if isMember();
      allow delete: if isManager();
    }
    match /robotPins/{id} {
      allow read, create, update: if isMember();
      allow delete: if isManager() || (isMember() && resource.data.byUid == request.auth.uid);
    }
    match /robotLayouts/{id} {
      allow read, create: if isMember();
      allow update, delete: if isManager() || (isMember() && resource.data.byUid == request.auth.uid);
    }

    // Feature requests: anyone on the team sends one as themselves and adds 👍;
    // team management sets the status and replies. Authors can delete theirs.
    match /requests/{id} {
      allow read: if isMember();
      allow create: if isMember() && !featureOff('requests') && request.resource.data.byUid == request.auth.uid
        && isMe(request.resource.data.by)
        && request.resource.data.text is string && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.status == 'new';
      // Everyone else: only their own 👍 / 👎.
      allow update: if requestsOwner() || (isMember()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes', 'downvotes'])
        && onlyMyVote('votes') && onlyMyVote('downvotes'));
      allow delete: if requestsOwner() || (isMember() && resource.data.byUid == request.auth.uid);
    }
    // Who feature requests go to (REQUESTS_TO in src/config.js): only they set
    // the status and reply. Joining under this name takes their manager code.
    function requestsOwner() { return isManager() && isMe('Asher Mosseri'); }
    function onlyMyVote(field) {
      return request.resource.data.get(field, {}).diff(resource.data.get(field, {})).affectedKeys().hasOnly([myName()]);
    }

    // Shifts (clock in/out). You clock yourself in (now, or up to 12 hours
    // earlier) and out; team management can add, fix, or remove anyone's.
    // A shift you started in the last 15 minutes can be cancelled. A finished
    // shift of yours you can delete or make shorter, each written down in
    // shiftEdits in the same batch; making one longer or adding a missed one
    // is a shiftRequest that team management approves.
    function nowMs() { return request.time.toMillis(); }
    function validStart(s) { return s is int && s <= nowMs() + 300000 && s >= nowMs() - 12 * 3600000; }
    function shiftPath(sid) { return /databases/$(database)/documents/shifts/$(sid); }
    function shiftEditPath(eid) { return /databases/$(database)/documents/shiftEdits/$(eid); }
    // A name that is me, or an old name of mine: a device that signed in
    // after a rename has the new name, and shifts keep the name they were
    // saved with.
    function wasMe(name) {
      return isMe(name) || (exists(namesPath()) && get(namesPath()).data.get('renames', {}).get(name, '') == myName());
    }
    match /shifts/{id} {
      // Your running shift: move the start earlier, end it, notes (as before).
      function runningChange() {
        return resource.data.end == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['start', 'end', 'note', 'subteam', 'taskIds', 'updatedBy'])
          && (request.resource.data.start == resource.data.start || validStart(request.resource.data.start))
          && (request.resource.data.end == resource.data.end
              || (request.resource.data.end is int && request.resource.data.end >= request.resource.data.start
                  && request.resource.data.end <= nowMs() + 300000));
      }
      function detailsChange() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['note', 'subteam', 'taskIds', 'updatedBy']);
      }
      // A finished shift made shorter (starts later and/or ends earlier), with its edit record.
      function shrink(n) {
        return resource.data.end != null
          && n.diff(resource.data).affectedKeys().hasOnly(['start', 'end', 'note', 'subteam', 'taskIds', 'updatedBy', 'editCount', 'editedAt', 'editedBy'])
          && n.start is int && n.end is int && n.start >= resource.data.start && n.end <= resource.data.end && n.end > n.start
          && n.editCount == resource.data.get('editCount', 0) + 1 && n.editedBy == myName() && n.editedAt is int
          && existsAfter(shiftEditPath(id + '_' + string(n.editCount)));
      }
      allow read: if isMember();
      allow create: if isManager() || (isMember() && isMe(request.resource.data.person)
        && request.resource.data.end == null && validStart(request.resource.data.start)
        && request.resource.data.byUid == request.auth.uid);
      allow update: if isManager() || (isMember() && wasMe(resource.data.person)
        && request.resource.data.person == resource.data.person
        && (runningChange() || detailsChange() || shrink(request.resource.data)));
      allow delete: if isManager() || (isMember() && wasMe(resource.data.person)
        && ((resource.data.end == null && resource.data.start > nowMs() - 15 * 60000)
            || (resource.data.end != null && existsAfter(shiftEditPath(id + '_del')))));
    }
    // Every change to a finished shift: who, when, and the times before and
    // after. Team management reads them. Nobody rewrites them. A teammate's
    // record has to match the change it goes with (ids <shift>_<editCount>
    // and <shift>_del); team management's are their own.
    match /shiftEdits/{eid} {
      function validEdit(d) {
        return d.keys().hasOnly(['shiftId', 'person', 'kind', 'by', 'byUid', 'at', 'before', 'after', 'requestId'])
          && d.shiftId is string && d.person is string && d.kind in ['shorten', 'delete', 'edit', 'add', 'approve']
          && d.by == myName() && d.byUid == request.auth.uid && d.at is int;
      }
      function ownEdit(d) {
        let old = get(shiftPath(d.shiftId)).data;
        return wasMe(old.person) && d.person == old.person && old.end != null
          && d.before.start == old.start && d.before.end == old.end
          && ((d.kind == 'delete' && eid == d.shiftId + '_del' && d.after == null && !existsAfter(shiftPath(d.shiftId)))
            || (d.kind == 'shorten' && eid == d.shiftId + '_' + string(getAfter(shiftPath(d.shiftId)).data.editCount)
                && d.after.start == getAfter(shiftPath(d.shiftId)).data.start
                && d.after.end == getAfter(shiftPath(d.shiftId)).data.end));
      }
      allow read: if isManager();
      allow create: if isMember() && validEdit(request.resource.data) && (isManager() || ownEdit(request.resource.data));
      allow update, delete: if false;
    }
    // Asking for a missed shift (kind 'add') or a longer one ('extend', with
    // the shift's times as they were). Only team management approves or
    // declines; you can take back your own.
    match /shiftRequests/{rid} {
      function validRequest(d) {
        return d.keys().hasOnly(['kind', 'person', 'by', 'byUid', 'shiftId', 'start', 'end', 'oldStart', 'oldEnd', 'note', 'subteam', 'taskIds', 'status', 'at', 'decidedBy', 'decidedAt'])
          && d.kind in ['add', 'extend'] && d.person is string && d.start is int && d.end is int
          && d.end > d.start && d.end - d.start <= 16 * 3600000 && d.end <= nowMs() + 300000 && d.start >= nowMs() - 60 * 86400000
          && d.get('note', '') is string && d.get('note', '').size() <= 500
          && d.get('subteam', '') is string && d.get('subteam', '').size() <= 40
          && d.get('taskIds', []) is list && d.get('taskIds', []).size() <= 30 && d.at is int;
      }
      function longerMine(d) {
        let old = get(shiftPath(d.shiftId)).data;
        return wasMe(old.person) && d.person == old.person && old.end != null
          && d.oldStart == old.start && d.oldEnd == old.end && (d.start < old.start || d.end > old.end);
      }
      allow read: if isMember();
      allow create: if isMember() && validRequest(request.resource.data) && request.resource.data.status == 'pending'
        && wasMe(request.resource.data.person) && request.resource.data.by == myName() && request.resource.data.byUid == request.auth.uid
        && (request.resource.data.kind == 'add' || longerMine(request.resource.data));
      allow update: if isManager() && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedBy', 'decidedAt'])
        && request.resource.data.status in ['approved', 'declined'] && request.resource.data.decidedBy == myName();
      allow delete: if isManager() || (isMember() && wasMe(resource.data.person));
    }
    // The schedule: team management plans shifts; anyone answers for themselves.
    match /shiftPlans/{id} {
      allow read: if isMember();
      allow create, delete: if isManager();
      allow update: if isManager() || (isMember()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['people'])
        && request.resource.data.people.diff(resource.data.people).affectedKeys().hasOnly([myName(), renamedMe()]));
    }

    // Lab check-ins: team management asks; everyone answers only for themselves.
    match /checkins/{id} {
      allow read: if isMember();
      allow create, delete: if isManager();
      allow update: if isManager() || (isMember() && !featureOff('checkins')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answers'])
        && request.resource.data.answers.diff(resource.data.answers).affectedKeys().hasOnly([myName(), renamedMe()]));
    }

    // Practice and match log: anyone on the team.
    match /runs/{id} {
      allow read, write: if isMember();
    }

    // Score predictions (functions/life.js predict): the team sees each round,
    // who guessed and, once it locks, the guesses. Only the server writes them;
    // guesses wait in predictions/{id}/secret, which nobody reads.
    match /predictions/{id} {
      allow read: if isMember();
      allow write: if false;
    }
    // The weekly recap's state per week (posted or skipped): the server only.
    match /recaps/{week} {
      allow read: if isMember();
      allow write: if false;
    }

    // Competition matches (Today's pit screen). Team management types in the
    // schedule (the ftcEvents function also writes it); anyone on the team
    // enters our score after a match.
    match /matches/{id} {
      allow read: if isMember();
      allow create, delete: if isManager();
      allow update: if isManager() || (isMember()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ours', 'result', 'updatedAt', 'updatedBy'])
        && (request.resource.data.get('ours', null) == null || request.resource.data.ours is map)
        && request.resource.data.get('result', '') in ['', 'win', 'loss', 'tie']);
    }

    // Notifications (the bell). Only the Cloud Functions create them; anyone on
    // the team can mark them read or clear them.
    match /inbox/{person}/items/{id} {
      allow read, delete: if isMember();
      allow update: if isMember() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    }
    // Devices that turned on phone notifications. Only the Cloud Functions read
    // them, and they send to the name in the device's members doc.
    match /pushTokens/{token} {
      allow create, update: if isMember() && request.resource.data.uid == request.auth.uid;
      allow delete: if isMember() && resource.data.uid == request.auth.uid;
    }

    // Deleting moves a task to Recently deleted (an update); only managers delete for good.
    // A done task pays coins to its assignees unless they created it
    // (functions/shared/coins.js), so the creator is whoever saves it first
    // and never changes, and its times come from the server's clock.
    function serverTime(d, k) { return d.get(k, null) == null || d.get(k, null) == request.time; }
    function stampedIfChanged(k) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([k]) || serverTime(request.resource.data, k);
    }
    match /tasks/{taskId} {
      allow read: if isMember();
      allow create: if isMember() && isMe(request.resource.data.get('createdBy', ''))
        && request.resource.data.get('createdAt', null) == request.time
        && serverTime(request.resource.data, 'completedAt') && serverTime(request.resource.data, 'updatedAt');
      allow update: if isMember()
        && request.resource.data.get('createdBy', null) == resource.data.get('createdBy', null)
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
        && stampedIfChanged('completedAt') && stampedIfChanged('updatedAt');
      allow delete: if isManager();

      // Comments + change history: anyone on the team can add; nobody can rewrite history.
      match /activity/{activityId} {
        allow read, create: if isMember();
      }
    }
  }
}
